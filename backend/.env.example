# --- PostgreSQL ---
POSTGRES_USER=radio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=radio_campus

# --- JWT ---
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5
